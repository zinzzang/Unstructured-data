          "centroid_cosine_similarity": 0.896302,
          "rank_in_topic": 1,
          "global_selection_rank": 1,
          "old_sentence_id": "20220415000576-P0001-S01",
          "old_text": "당사는 반도체 제조용 장비 (Vision Placement, EMI Shield Vision Attach / Detach,TSV Dual Stacking TC Bonder, Flip Chip Bonder, Laser Marking/Cutting/Ablation/Drilling/META Grinder 등) 를 개발해 국내외 유수의 반도체 기업에 공급하고 있습니다.1980년 설립 이래, 반도체 제조용 장비의 출시를 시작으로 최첨단 자동화 장비에 이르기까지 반도체 생산 장비를 자체 기술로 설계, 제작, 조립, 검사, Test하는 수직계열화 방식의 일괄 생산라인을 갖추고 세계적인 경쟁력을 확보하여 국내외 320여개의반도체 관련 제조업체( IDM, OSAT 등 )에 장비를 공급해 오고 있습니다.",
          "old_section_path": "II. 사업의 내용 > 1. 사업의 개요",
          "old_xml_line": 2495,
          "new_sentence_id": null,
